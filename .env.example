# Copy this file to .env and fill in the values marked REPLACE-ME.
# .env is gitignored. Every variable here is read by internal/config, which
# validates and fails fast at startup. `make` auto-loads .env into every
# target (Make parses it: an unquoted '#' starts a comment, '$' must be '$$').

# -- Postgres -----------------------------------------------------------------
# Required: DB, USER, PASSWORD. Defaults match docker-compose.yml
# ('localhost:15432' is the host-mapped port).
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
# TLS mode. 'disable' for local compose; production MUST set require (or
# verify-ca / verify-full when the server cert is verifiable).
POSTGRES_SSLMODE=disable

# -- API server ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

# -- JWT access tokens --------------------------------------------------------
# JWT_SECRET must be at least 32 characters:  openssl rand -base64 48
# TTL is intentionally short (15m); session renewal is the refresh cookie.
JWT_SECRET=REPLACE-ME-with-a-secret-at-least-32-chars-long
JWT_ISSUER=bold-back-boiler
JWT_TTL_SECONDS=900

# -- Refresh-token sessions ----------------------------------------------------
# Login / accept-invite / Google sign-in also set a rotating httpOnly refresh
# cookie (Path=/auth). POST /auth/refresh rotates it; reusing a rotated or
# revoked token revokes the whole session family. POST /auth/logout revokes.
REFRESH_TOKEN_IDLE_HOURS=336
REFRESH_TOKEN_ABSOLUTE_HOURS=2160
REFRESH_COOKIE_NAME=app_refresh
# lax when SPA and API share a site; cross-site production MUST use none
# (forces Secure).
REFRESH_COOKIE_SAMESITE=lax
# Optional: share the cookie across subdomains (e.g. .example.com).
REFRESH_COOKIE_DOMAIN=
# Sweeper drops rotated/revoked refresh rows older than the retention window.
REFRESH_SWEEP_ENABLED=true
REFRESH_SWEEP_INTERVAL_MINUTES=60
REFRESH_TOKEN_RETENTION_HOURS=720

# -- Frontend / CORS ----------------------------------------------------------
# Origin the SPA is served from. Always an allowed origin for credentialed
# CORS; also where invite links (/invite?token=) and the Google callback
# redirect to. Default targets local Vite dev.
FRONTEND_BASE_URL=http://localhost:4200
# Extra SPA origins, comma separated (no wildcard: credentialed CORS).
CORS_ALLOWED_ORIGINS=

# -- Google sign-in (optional) ------------------------------------------------
# Set ALL THREE to enable /auth/google/*, or leave all blank for a
# password-only product (partial config is a startup error). Google sign-in
# authenticates EXISTING users only (invite-only invariant).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/auth/google/callback

# -- Tenancy ------------------------------------------------------------------
# The first customer tenant, created by the init migration (validated at
# every startup, consumed only once). Slug: ^[a-z0-9][a-z0-9-]{1,62}$
DEFAULT_TENANT_NAME=Default Tenant
DEFAULT_TENANT_SLUG=default
# Synthetic tenant that holds superadmin users (no departments).
PLATFORM_TENANT_SLUG=platform
# Soft-deleted tenants are restorable for this many hours before the sweeper
# hard-deletes them (FK cascade drops every row under their tenant_id).
TENANT_SWEEP_ENABLED=true
TENANT_SWEEP_INTERVAL_MINUTES=60
TENANT_DELETE_GRACE_HOURS=168
TENANT_SWEEP_BATCH_SIZE=50

# -- Invites ------------------------------------------------------------------
# Invite token TTL (hours). Emails link to FRONTEND_BASE_URL/invite?token=<raw>.
INVITE_TTL_HOURS=168

# -- Email --------------------------------------------------------------------
# 'on' sends via AWS SES (requires SES_FROM_ADDRESS + PUBLIC_BASE_URL and AWS
# credentials from the SDK default chain); 'off' logs the email instead so
# local dev needs no AWS account. SES_REGION defaults to us-east-1.
EMAIL_DELIVERY=off
SES_REGION=
SES_FROM_ADDRESS=
PUBLIC_BASE_URL=

# -- Superadmin bootstrap (optional) ------------------------------------------
# Seeds the first platform superadmin on startup. Set ALL THREE or none.
# Idempotent: an existing superadmin with this email is left untouched.
# Rotate the password after first login (PATCH /me) and prefer a secret store.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_DISPLAY_NAME=
